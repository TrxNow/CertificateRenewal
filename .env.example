# Copy to .env on the Omarchy host and fill in values.
# .env is loaded by scripts/run-renewal.sh (not committed).

# true = certbot renew --dry-run; emails still send on reminder/notice days
DEV_MODE=true

# Required for any email. Example: smtp.office365.com or smtp.gmail.com
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=you@trx-now.com
# Quote values that contain spaces (Gmail app passwords).
SMTP_PASSWORD="xxxx xxxx xxxx xxxx"
SMTP_FROM=you@trx-now.com

# Optional. Defaults to <repo>/data/letsencrypt
# LETSENCRYPT_ROOT=
