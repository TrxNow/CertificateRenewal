# Copy to .env on the Omarchy host and fill in values.
# .env is loaded by scripts/run-renewal.sh (not committed).

# true = certbot renew --dry-run, skip emails
DEV_MODE=true

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional. Defaults to <repo>/data/letsencrypt
# LETSENCRYPT_ROOT=
